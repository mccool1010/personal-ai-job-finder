# ============================================
# Personal AI Job Finder — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Server ---
PORT=5000
NODE_ENV=development
SECRET_KEY=your-random-secret-key-here

# --- Database ---
# MongoDB Atlas connection string (free M0 tier)
# Get yours at: https://cloud.mongodb.com
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/job-finder?retryWrites=true&w=majority

# --- Job Source APIs ---

# Adzuna (free: ~1000 calls/month)
# Register at: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Remotive — no key needed (public API)
# Arbeitnow — no key needed (public API)

# --- LLM API (Optional) ---
# For AI features: cover letter, match explanation, resume parsing intelligence
# Leave blank to use deterministic-only matching (fully functional without LLM)
LLM_API_KEY=
LLM_PROVIDER=gemini
# Options: gemini, openai

# --- Frontend ---
VITE_API_URL=http://localhost:5000/api
