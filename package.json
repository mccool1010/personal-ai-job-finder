{
  "name": "personal-ai-job-finder",
  "version": "1.0.0",
  "private": true,
  "description": "Personal AI Job Finder — Upload resumes, search jobs across India and internationally, get match scores, and track applications.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
